{
  "schema_version": 1,
  "source_repository": "fdsasaaa/caipiaowenzhang",
  "source_ref": "main",
  "source_root": "articles/approved",
  "transport_status": "contract_ready_disabled",
  "sync_enabled": false,
  "allowed_source_status": ["approved"],
  "destination_publication_state": "draft",
  "allow_create_publish_at": false,
  "allow_promote_to_scheduled": false,
  "allow_invoke_publisher": false,
  "allow_change_publisher_cron": false,
  "allow_consume_scheduled_queue": false,
  "category_policy": {
    "site_category_map": "config/content_category_map.json",
    "ordinary_seo_article_category_key": "tzjq",
    "retired_category_keys": ["seo-articles"],
    "unknown_category_key_fails_closed": true,
    "website_must_not_guess_category_from_title_or_keyword": true
  },
  "identity_and_idempotency": {
    "required_identity_fields": ["article_id", "source_fingerprint", "content_hash"],
    "same_article_id_same_hash": "idempotent_unchanged",
    "same_article_id_different_hash": "reject_requires_revision_and_reapproval",
    "missing_identity_field": "reject"
  },
  "defense_in_depth": {
    "website_revalidates_approved_package": true,
    "approved_package_is_not_publication_authorization": true,
    "draft_must_not_have_publish_at": true,
    "publication_receipt_required_for_published_identity": true
  },
  "future_activation_requires": [
    "explicit_user_approval_to_enable_cross_repo_sync",
    "trusted_private_repository_transport",
    "source_contract_matches_current_website_category_policy",
    "dry_run_inventory_and_duplicate_check_pass",
    "approved_to_draft_batch_smoke_pass",
    "publishing_remains_separately_gated"
  ],
  "notes": "This policy prepares future automatic retrieval of Approved Packages from the content-engine repository. It deliberately does not authorize scheduling or publication."
}
